NEXT_PUBLIC_DEFAULT_COMPANY=VANCE


# Authentication
# Trusted orchestrator base URL and exact token issuer.
AUTH_ORCHESTRATOR_URL=https://orca.biztechro.com
AUTH_EXPECTED_ISSUER=https://orca.biztechro.com
# Orchestrator login path (default shown; /auth/login for Entra).
# AUTH_LOGIN_PATH=/auth/local-login
# JWT_SECRET is REQUIRED when fallback admin is enabled; signs only its session.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-change-in-production-use-long-random-string
# Lifetime of the fallback-admin session only (not bt_session).
JWT_EXPIRES_IN=7d
AUTH_DB_PATH=./data/auth.db
# Users come from orchestrator sign-in. Manage local roles/links with:
# npm run users -- role <username> <admin|user>
# npm run users -- link <username> <orchestrator-username>

# Affects only the fallback session cookie, never bt_session.
# Set to true only if this app is served over HTTPS (marks the session
# cookie Secure, so browsers refuse to send/set it over plain HTTP).
# Leave false for the normal internal-network HTTP deployment.
COOKIE_SECURE=false

# Break-glass sign-in on /login; works regardless of orchestrator and DB state.
# Both variables must be set to enable it. Leave unset to disable.
# FALLBACK_ADMIN_USERNAME=admin
# FALLBACK_ADMIN_PASSWORD=pick-a-strong-password

# Application Settings
NEXT_PUBLIC_APP_NAME=Client Data Management System

# BTClientDataAPI — all client-infrastructure data is read and written
# through this service.
DATA_API_BASE_URL=http://192.168.203.238:7310
DATA_API_TIMEOUT_MS=10000
DATA_API_PAGE_SIZE=1000

# Logging
LOG_LEVEL=info

# Set to true to bypass login entirely (e.g. during a migration window)
DISABLE_AUTH=false

# Folder of phone-system user exports, one <client abbreviation>.xlsx per
# client (read-only; powers the dashboard Phones button). Spaces are fine.
# PHONE_LIST=/mnt/SharedFolders/Data/Phone Lists/Mills phone user lists
PHONE_LIST=